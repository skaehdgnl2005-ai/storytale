# ==============================
# StoryTale 환경변수 예제
# 이 파일을 .env로 복사하여 사용하세요.
# ==============================

# --- 데이터베이스 ---
DATABASE_URL=postgresql+asyncpg://storytale:storytale_dev@localhost:5432/storytale
POSTGRES_DB=storytale
POSTGRES_USER=storytale
POSTGRES_PASSWORD=storytale_dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- AI 서비스 ---
CLAUDE_API_KEY=sk-ant-your-key-here
# GEMINI_API_KEY: 설정 시 Claude 서버 장애 시 Gemini 3.1 Pro로 자동 fallback
# 미설정 시 Claude 단독 모드로 동작 (기존 동작 유지)
GEMINI_API_KEY=
REPLICATE_API_TOKEN=r8_your-token-here

# --- AWS S3 (일러스트 저장) ---
AWS_S3_BUCKET=storytale-illustrations
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-northeast-2

# --- 앱 설정 ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-in-production

# --- CORS ---
CORS_ORIGINS=["http://localhost:8081"]
